<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd job that runs yonsei_jobboard_sync.py on a schedule, fully
  unattended (headless, no window, no interruption).

  Install:
    1. Edit the two placeholder paths below:
       - the python3 path (find yours with: which python3)
       - the full path to yonsei_jobboard_sync.py in this folder
    2. Copy this file to ~/Library/LaunchAgents/
       cp yonsei_jobboard_sync.plist ~/Library/LaunchAgents/com.kristoffergt.yonsei-jobboard-sync.plist
    3. Load it:
       launchctl load ~/Library/LaunchAgents/com.kristoffergt.yonsei-jobboard-sync.plist
    4. Check it's running / see output:
       tail -f /tmp/yonsei_jobboard_sync.log

  This only runs while you're logged into the Mac (screen-locked is fine,
  fully logged out or powered off is not) -- it's a per-user launchd agent,
  not a system daemon.

  To stop it:
    launchctl unload ~/Library/LaunchAgents/com.kristoffergt.yonsei-jobboard-sync.plist

  StartInterval below is 3600 seconds (every hour). Change it to whatever
  cadence you want.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.kristoffergt.yonsei-jobboard-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/Users/kristoffertiedemann/Desktop/Personal/Productivity Tracker - Website Builder/scripts/yonsei_jobboard_sync.py</string>
	</array>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/yonsei_jobboard_sync.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/yonsei_jobboard_sync.log</string>
</dict>
</plist>
