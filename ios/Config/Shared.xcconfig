// Build settings for both targets (the project's base configuration).
//
// The signing team is not written here or in project.pbxproj: it goes in
// Config/Local.xcconfig, which git ignores. Copy Local.xcconfig.example to
// Local.xcconfig and put the team ID in it. With no team the app still builds
// and runs in the Simulator.

// One App Group for the app and its widget: the widget reads today's to-dos
// and study time from it.
TR_APP_GROUP = group.com.kristoffergt.tracker

#include? "Local.xcconfig"
