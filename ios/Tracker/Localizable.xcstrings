{
  "sourceLanguage" : "en",
  "strings" : {
    "A different one each time" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매번 다른 배치"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi lần một bố cục khác"
          }
        }
      }
    },
    "Dark" : {
